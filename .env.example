# Copy to .env and fill in. Never commit the real .env file.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Defaults to a local SQLite file (db.sqlite3). For MySQL:
# DATABASE_URL=mysql://USER:PASSWORD@HOST/DBNAME

# Models and inference
# MODEL_A_WEIGHTS=models/yolov8x_decay_filling.pt
# MODEL_B_WEIGHTS=models/yolov8m_caries.pt
# MODEL_CONF=0.25
# FUSED_CONF=0.25
# FUSION_IOU=0.5
# FUSION_CONTAINMENT=0.8
# CLAHE_MODELS=yolov8x          # comma-separated; empty (default) disables CLAHE
# CLAHE_CLIP_LIMIT=2.0
# CLAHE_TILE_GRID=8
# DEVICE=cpu
